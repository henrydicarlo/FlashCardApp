+    /**
+     * Gera prévias dos intervalos estimados para os botões de avaliação (em dias)
+     */
+    fun previewIntervals(studyInfo: StudyInfo): Map<String, Int> {
+        val base = studyInfo.copy()
+
+        val difficultFactor = max(MIN_EASE_FACTOR, base.easeFactor - 0.15)
+        val goodFactor = max(MIN_EASE_FACTOR, base.easeFactor - 0.05)
+        val easyFactor = min(MAX_EASE_FACTOR, base.easeFactor + 0.0) // não muda no botão fácil
+
+        return mapOf(
+            "Difícil" to estimateInterval(base.repetitions, base.interval, difficultFactor, 1.2),
+            "Bom" to estimateInterval(base.repetitions, base.interval, goodFactor, 1.0),
+            "Fácil" to estimateInterval(base.repetitions, base.interval, easyFactor, 1.0)
+        )
+    }
+
+    private fun estimateInterval(reps: Int, interval: Int, ease: Double, multiplier: Double): Int {
+        return when (reps) {
+            0 -> 1
+            1 -> 3
+            else -> max(1, (interval * ease * multiplier).toInt())
+        }
+    }
+}
